<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Emploi du temps — Groupe Scolaire SALDIA</title>
<style>
  :root {
    --marine: #0f2942;
    --marine-clair: #1e4266;
    --or: #b8860b;
    --or-clair: #f5e6c8;
    --vert: #15803d;
    --rouge: #b91c1c;
    --fond: #f7f7f5;
    --carte: #ffffff;
    --bordure: #e2e2de;
    --texte: #1c1c1c;
    --texte-att: #6b6b66;
  }
  * { box-sizing: border-box; }
  body {
    font-family: "Segoe UI", -apple-system, Roboto, Arial, sans-serif;
    background: var(--fond);
    color: var(--texte);
    margin: 0;
    padding: 0 0 60px 0;
    line-height: 1.55;
  }

  header {
    background: var(--marine);
    color: white;
    padding: 22px 24px;
  }
  .entete-contenu { max-width: 980px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .logo-ecole { display: flex; align-items: center; gap: 12px; }
  .logo-ecole .badge-logo {
    width: 42px; height: 42px; border-radius: 8px;
    background: var(--or); color: var(--marine);
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 15px; letter-spacing: -0.5px;
  }
  header h1 { margin: 0; font-size: 18px; font-weight: 600; }
  header p { margin: 2px 0 0 0; opacity: 0.75; font-size: 13px; }
  .statut-sauvegarde { font-size: 12px; color: var(--or-clair); opacity: 0.9; }

  .conteneur { max-width: 980px; margin: 0 auto; padding: 24px 20px; }

  /* --- Navigation par étapes --- */
  nav.etapes-nav {
    display: flex;
    background: var(--carte);
    border: 1px solid var(--bordure);
    border-radius: 12px;
    padding: 6px;
    margin-bottom: 22px;
    gap: 4px;
    overflow-x: auto;
  }
  nav.etapes-nav button {
    flex: 1;
    min-width: 130px;
    background: transparent;
    color: var(--texte-att);
    border: none;
    padding: 10px 8px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }
  nav.etapes-nav button .puce {
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--bordure); color: white;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px;
  }
  nav.etapes-nav button.actif { background: var(--marine); color: white; }
  nav.etapes-nav button.actif .puce { background: var(--or); color: var(--marine); }
  nav.etapes-nav button.complet .puce { background: var(--vert); }

  .etape { display: none; }
  .etape.active { display: block; }

  .carte {
    background: var(--carte);
    border: 1px solid var(--bordure);
    border-radius: 12px;
    padding: 22px;
    margin-bottom: 18px;
  }
  .carte h2 { margin: 0 0 4px 0; font-size: 18px; color: var(--marine); }
  .carte .sous-titre { margin: 0 0 16px 0; font-size: 13px; color: var(--texte-att); }

  .aide {
    background: #f0f6fb;
    border-left: 3px solid var(--marine-clair);
    padding: 10px 14px;
    font-size: 13px;
    color: #1e3a5f;
    border-radius: 4px;
    margin-bottom: 18px;
  }
  .aide b { color: var(--marine); }

  label { font-size: 12.5px; color: var(--texte-att); display: block; margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3px; }
  input[type=text], input[type=number], select {
    padding: 9px 11px;
    border: 1px solid var(--bordure);
    border-radius: 7px;
    font-size: 14px;
    width: 100%;
    background: white;
  }
  input:focus, select:focus { outline: 2px solid var(--marine-clair); outline-offset: 1px; }

  .ligne-form { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; margin-bottom: 16px; }
  .champ { flex: 1; min-width: 140px; }

  button.principal, button {
    background: var(--marine);
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 7px;
    font-size: 14px;
    cursor: pointer;
    font-weight: 600;
  }
  button:hover { filter: brightness(1.1); }
  button.or { background: var(--or); color: var(--marine); }
  button.secondaire { background: white; color: var(--marine); border: 1px solid var(--marine); }
  button.discret { background: var(--fond); color: var(--texte-att); border: 1px solid var(--bordure); font-weight: 500; }
  button.danger { background: white; color: var(--rouge); border: 1px solid var(--rouge); padding: 5px 10px; font-size: 12px; font-weight: 600; }
  button:disabled { opacity: 0.4; cursor: not-allowed; }

  table { width: 100%; border-collapse: collapse; font-size: 13.5px; margin-top: 6px; }
  th, td { border: 1px solid var(--bordure); padding: 8px 10px; text-align: left; }
  th { background: var(--fond); font-weight: 700; color: var(--marine); font-size: 12px; text-transform: uppercase; letter-spacing: 0.3px; }
  tr:hover td { background: #fafaf8; }

  .grille-dispo { overflow-x: auto; border: 1px solid var(--bordure); border-radius: 8px; }
  .grille-dispo table { min-width: 720px; margin: 0; }
  .grille-dispo th, .grille-dispo td { border: 1px solid var(--bordure); }
  .case-dispo { text-align: center; cursor: pointer; user-select: none; font-size: 15px; color: var(--bordure); font-weight: bold; }
  .case-dispo.actif { background: #ecfdf3; color: var(--vert); }
  .case-dispo:hover { background: #f0f0ee; }

  .barre-dispo-actions { display: flex; gap: 8px; margin: 10px 0 16px 0; }

  .carte-prof {
    border: 1px solid var(--bordure);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--fond);
  }
  .carte-prof .nom { font-weight: 700; color: var(--marine); }
  .carte-prof .details { font-size: 12.5px; color: var(--texte-att); margin-top: 2px; }
  .tag-temps-plein { display: inline-block; background: var(--or-clair); color: #7a5a05; font-size: 11px; padding: 1px 7px; border-radius: 8px; margin-left: 6px; font-weight: 700; }

  .message-erreur { background: #fef2f2; border-left: 3px solid var(--rouge); color: #991b1b; padding: 12px 14px; border-radius: 4px; font-size: 13px; margin-top: 14px; }
  .message-succes { background: #f0fdf4; border-left: 3px solid var(--vert); color: #166534; padding: 12px 14px; border-radius: 4px; font-size: 13px; margin-top: 14px; }
  .message-avert { background: #fffbeb; border-left: 3px solid var(--or); color: #7a5a05; padding: 12px 14px; border-radius: 4px; font-size: 13px; margin-top: 14px; }

  .onglets-classes { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 16px; }
  .onglet-classe { padding: 7px 14px; border-radius: 7px; border: 1px solid var(--bordure); background: white; cursor: pointer; font-size: 13px; font-weight: 600; }
  .onglet-classe.actif { background: var(--marine); color: white; border-color: var(--marine); }

  .actions-resultat { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 18px; }
  .nav-bas { display: flex; justify-content: space-between; margin-top: 22px; }

  footer { text-align: center; font-size: 12px; color: #9c9c96; margin-top: 30px; }

  @media print {
    header, nav.etapes-nav, .carte, .actions-resultat, .onglets-classes, footer { display: none !important; }
    #resultatImpression { display: block !important; }
  }
  #resultatImpression { display: none; }
  #resultatImpression h1 { color: var(--marine); }
  #resultatImpression table { border-collapse: collapse; width: 100%; margin-bottom: 26px; }
  #resultatImpression th, #resultatImpression td { border: 1px solid #888; padding: 6px; font-size: 12px; }
</style>
</head>
<body>

<header>
  <div class="entete-contenu">
    <div class="logo-ecole">
      <div class="badge-logo">GS</div>
      <div>
        <h1>Groupe Scolaire SALDIA</h1>
        <p>Générateur d'emploi du temps</p>
      </div>
    </div>
    <div class="statut-sauvegarde">Enregistrement automatique actif</div>
  </div>
</header>

<div class="conteneur">

  <nav class="etapes-nav" id="navEtapes"></nav>

  <!-- ETAPE 1 : CLASSES -->
  <div class="etape" data-etape="1">
    <div class="carte">
      <h2>Les classes</h2>
      <p class="sous-titre">Crée chaque division. Les matières et heures se règlent ensuite une seule fois par niveau, à l'étape suivante.</p>

      <div class="ligne-form">
        <div class="champ">
          <label>Cycle</label>
          <select id="classeCycle">
            <option value="collège">Collège</option>
            <option value="lycée">Lycée</option>
          </select>
        </div>
        <div class="champ">
          <label>Niveau (ex : 6ème, 2nde)</label>
          <input type="text" id="classeNiveau" placeholder="6ème">
        </div>
        <div class="champ">
          <label>Division (ex : M1, S A)</label>
          <input type="text" id="classeDivision" placeholder="M1">
        </div>
        <div>
          <button onclick="ajouterClasse()">Ajouter la classe</button>
        </div>
      </div>

      <table id="tableClasses">
        <thead><tr><th>Classe</th><th>Cycle</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <!-- ETAPE 2 : VOLUMES HORAIRES PAR NIVEAU -->
  <div class="etape" data-etape="2">
    <div class="carte">
      <h2>Matières et heures par niveau</h2>
      <p class="sous-titre">Un seul réglage par niveau — il s'applique automatiquement à toutes ses divisions.</p>
      <div class="aide">
        <b>Exemple :</b> tu règles "6ème → Français → 4h". Toutes les classes de 6ème
        (6ème M1, 6ème M2, 6ème M3…) auront automatiquement 4h de Français par semaine —
        tu n'as pas besoin de le refaire classe par classe.
      </div>

      <div class="ligne-form">
        <div class="champ">
          <label>Niveau</label>
          <select id="volumeNiveau"></select>
        </div>
        <div class="champ">
          <label>Matière</label>
          <input type="text" id="volumeMatiere" placeholder="Français">
        </div>
        <div class="champ" style="max-width:150px;">
          <label>Heures / semaine</label>
          <input type="number" id="volumeHeures" min="1" max="20">
        </div>
        <div>
          <button onclick="ajouterVolume()">Ajouter</button>
        </div>
      </div>

      <table id="tableVolumes">
        <thead><tr><th>Niveau</th><th>Matière</th><th>Heures/semaine</th><th>Divisions concernées</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <!-- ETAPE 3 : PROFESSEURS -->
  <div class="etape" data-etape="3">
    <div class="carte">
      <h2>Professeurs et disponibilités</h2>
      <p class="sous-titre">Coche les créneaux où le professeur peut donner cours. Un clic sur une case = disponible (vert).</p>

      <div class="ligne-form">
        <div class="champ">
          <label>Nom du professeur</label>
          <input type="text" id="profNom" placeholder="M. Fall">
        </div>
        <div class="champ">
          <label>Matière(s) enseignée(s)</label>
          <input type="text" id="profMatieres" placeholder="Physique-Chimie">
        </div>
      </div>

      <div class="barre-dispo-actions">
        <button class="or" onclick="basculerTempsPlein()">☀ Disponible à temps plein (tout cocher)</button>
        <button class="discret" onclick="viderDispoNouveau()">Tout décocher</button>
      </div>

      <div class="grille-dispo">
        <table id="grilleDispoNouveau"></table>
      </div>

      <div style="margin-top:16px;">
        <button onclick="ajouterProf()">Enregistrer ce professeur</button>
      </div>

      <div id="listeProfs" style="margin-top:22px;"></div>
    </div>
  </div>

  <!-- ETAPE 4 : LIER PROF <-> MATIERE <-> CLASSE -->
  <div class="etape" data-etape="4">
    <div class="carte">
      <h2>Qui enseigne quoi</h2>
      <p class="sous-titre">Relie chaque matière d'une classe précise à un professeur. Les heures viennent automatiquement du niveau (étape 2).</p>

      <div class="ligne-form">
        <div class="champ">
          <label>Classe</label>
          <select id="liaisonClasse" onchange="rafraichirMatieresLiaison()"></select>
        </div>
        <div class="champ">
          <label>Matière</label>
          <select id="liaisonMatiere" onchange="rafraichirProfsLiaison()"></select>
        </div>
        <div class="champ">
          <label>Professeur</label>
          <select id="liaisonProf"></select>
        </div>
        <div>
          <button onclick="ajouterLiaison()">Ajouter</button>
        </div>
      </div>
      <div id="avertLiaison"></div>

      <table id="tableLiaisons">
        <thead><tr><th>Classe</th><th>Matière</th><th>Professeur</th><th>Heures</th><th></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </div>

  <!-- ETAPE 5 : GENERATION -->
  <div class="etape" data-etape="5">
    <div class="carte" style="text-align:center; padding:36px 22px;">
      <h2 style="text-align:center;">Générer l'emploi du temps</h2>
      <p class="sous-titre" style="text-align:center;">Une fois les 4 étapes remplies, clique ci-dessous pour calculer le planning.</p>
      <button class="or" style="font-size:15px; padding:13px 26px;" onclick="genererPlanning()">Générer l'emploi du temps</button>
      <div id="messageGeneration"></div>
    </div>

    <div class="carte" id="zoneResultat" style="display:none;">
      <h2>Emploi du temps généré</h2>
      <div class="onglets-classes" id="ongletsClasses"></div>
      <div id="grilleResultat"></div>
      <div class="actions-resultat">
        <button class="or" onclick="window.print()">Exporter en PDF (impression)</button>
        <button class="secondaire" onclick="allerEtape(5)">Re-générer</button>
      </div>
    </div>
  </div>

  <div class="carte" style="border-color:#f0d0d0;">
    <h2 style="font-size:13px; color:#b9b9b3; margin-bottom:8px;">Zone de sécurité</h2>
    <button class="danger" style="padding:8px 14px; font-size:13px;" onclick="toutEffacer()">Tout effacer et recommencer</button>
  </div>

</div>

<div id="resultatImpression"></div>

<footer>Toutes les données restent dans ce navigateur (aucun serveur, aucun envoi).</footer>

<script>
/* ==========================================================
   CONFIGURATION FIXE (grille de sonneries du Groupe Scolaire)
   ========================================================== */
const JOURS = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi"];

const CRENEAUX_COLLEGE = [
  {id:"C1", label:"C1 (8h-9h)"}, {id:"C2", label:"C2 (9h-10h)"}, {id:"C3", label:"C3 (10h-10h50)"},
  {id:"C4", label:"C4 (11h05-12h05)"}, {id:"C5", label:"C5 (12h05-13h05)"},
  {id:"C6", label:"C6 (13h35-14h35)"}, {id:"C7", label:"C7 (14h35-15h35)"},
];
const CRENEAUX_LYCEE = CRENEAUX_COLLEGE.concat([
  {id:"C8", label:"C8 (15h35-16h35)"}, {id:"C9", label:"C9 (16h35-17h35)"},
]);
const CRENEAUX_TOUS = CRENEAUX_LYCEE;

function creneauxDuCycle(cycle) { return cycle === "lycée" ? CRENEAUX_LYCEE : CRENEAUX_COLLEGE; }
function normaliser(txt) { return (txt || "").trim().toLowerCase(); }

/* ==========================================================
   ETAT DE L'APPLICATION (sauvegardé dans localStorage)
   ========================================================== */
let etat = {
  classes: [],           // {id, cycle, niveau, division}
  volumesParNiveau: [],  // {id, cycle, niveau, matiere, heures}
  profs: [],              // {id, nom, matieres:[...], dispo: {jour: {creneauId: bool}}}
  liaisons: [],           // {id, classeId, matiere, profId}  (heures calculées dynamiquement)
  resultat: null
};

function sauvegarder() { localStorage.setItem("saldia_etat", JSON.stringify(etat)); }
function charger() {
  const brut = localStorage.getItem("saldia_etat");
  if (brut) { try { etat = JSON.parse(brut); } catch(e) {} }
}
function toutEffacer() {
  if (!confirm("Tout effacer (classes, profs, matières, planning) ? Cette action est irréversible.")) return;
  localStorage.removeItem("saldia_etat");
  location.reload();
}
function nouvelId(prefixe) { return prefixe + "_" + Math.random().toString(36).slice(2, 9); }

/* ==========================================================
   NAVIGATION PAR ETAPES
   ========================================================== */
const LIBELLES_ETAPES = ["Classes", "Matières / heures", "Professeurs", "Qui enseigne quoi", "Générer"];
let etapeActive = 1;

function allerEtape(n) {
  etapeActive = n;
  document.querySelectorAll(".etape").forEach(el => {
    el.classList.toggle("active", Number(el.dataset.etape) === n);
  });
  construireNavEtapes();
  window.scrollTo({ top: 0, behavior: "smooth" });
}
function construireNavEtapes() {
  const nav = document.getElementById("navEtapes");
  nav.innerHTML = "";
  LIBELLES_ETAPES.forEach((label, i) => {
    const n = i + 1;
    const btn = document.createElement("button");
    btn.className = (n === etapeActive ? "actif" : "") + (etapeComplete(n) ? " complet" : "");
    btn.innerHTML = `<span class="puce">${etapeComplete(n) && n !== etapeActive ? "✓" : n}</span><span>${label}</span>`;
    btn.onclick = () => allerEtape(n);
    nav.appendChild(btn);
  });
}
function etapeComplete(n) {
  if (n === 1) return etat.classes.length > 0;
  if (n === 2) return etat.volumesParNiveau.length > 0;
  if (n === 3) return etat.profs.length > 0;
  if (n === 4) return etat.liaisons.length > 0;
  if (n === 5) return !!(etat.resultat && etat.resultat.length > 0);
  return false;
}

/* ==========================================================
   NIVEAUX (déduits des classes) + AIDES
   ========================================================== */
function niveauxDistincts() {
  const vus = new Set();
  const liste = [];
  etat.classes.forEach(c => {
    const cle = c.cycle + "||" + c.niveau;
    if (!vus.has(cle)) { vus.add(cle); liste.push({ cle, cycle: c.cycle, niveau: c.niveau }); }
  });
  return liste;
}
function nomClasse(c) { return `${c.niveau} ${c.division} (${c.cycle})`; }
function nomNiveau(n) { return `${n.niveau} (${n.cycle})`; }
function volumesDuNiveau(cycle, niveau) {
  return etat.volumesParNiveau.filter(v => v.cycle === cycle && v.niveau === niveau);
}
function matieresPourClasse(classe) {
  return volumesDuNiveau(classe.cycle, classe.niveau);
}
function heuresPour(classe, matiere) {
  const v = matieresPourClasse(classe).find(v => v.matiere === matiere);
  return v ? v.heures : null;
}
function nbClassesDuNiveau(cycle, niveau) {
  return etat.classes.filter(c => c.cycle === cycle && c.niveau === niveau).length;
}

/* ==========================================================
   ETAPE 1 : CLASSES
   ========================================================== */
function ajouterClasse() {
  const cycle = document.getElementById("classeCycle").value;
  const niveau = document.getElementById("classeNiveau").value.trim();
  const division = document.getElementById("classeDivision").value.trim();
  if (!niveau || !division) { alert("Indique le niveau et la division."); return; }

  const id = nouvelId("classe");
  etat.classes.push({ id, cycle, niveau, division });
  document.getElementById("classeNiveau").value = "";
  document.getElementById("classeDivision").value = "";
  sauvegarder();
  rafraichirTout();
}
function supprimerClasse(id) {
  if (!confirm("Supprimer cette classe et les liaisons associées ?")) return;
  etat.classes = etat.classes.filter(c => c.id !== id);
  etat.liaisons = etat.liaisons.filter(l => l.classeId !== id);
  sauvegarder();
  rafraichirTout();
}

/* ==========================================================
   ETAPE 2 : VOLUMES HORAIRES PAR NIVEAU
   ========================================================== */
function ajouterVolume() {
  const cle = document.getElementById("volumeNiveau").value;
  const matiere = document.getElementById("volumeMatiere").value.trim();
  const heures = parseInt(document.getElementById("volumeHeures").value, 10);
  if (!cle) { alert("Ajoute d'abord une classe à l'étape 1 (le niveau en sera déduit)."); return; }
  if (!matiere || !heures || heures < 1) { alert("Indique une matière et un nombre d'heures valide."); return; }

  const [cycle, niveau] = cle.split("||");
  const existeDeja = etat.volumesParNiveau.some(v => v.cycle === cycle && v.niveau === niveau && normaliser(v.matiere) === normaliser(matiere));
  if (existeDeja) { alert("Cette matière est déjà réglée pour ce niveau. Supprime-la d'abord si tu veux changer les heures."); return; }

  etat.volumesParNiveau.push({ id: nouvelId("vol"), cycle, niveau, matiere, heures });
  document.getElementById("volumeMatiere").value = "";
  document.getElementById("volumeHeures").value = "";
  sauvegarder();
  rafraichirTout();
}
function supprimerVolume(id) {
  const v = etat.volumesParNiveau.find(x => x.id === id);
  if (!v) return;
  if (!confirm("Supprimer cette matière pour ce niveau ? Les liaisons \"qui enseigne quoi\" qui en dépendent seront aussi supprimées.")) return;
  etat.volumesParNiveau = etat.volumesParNiveau.filter(x => x.id !== id);
  // Nettoie les liaisons devenues invalides
  etat.liaisons = etat.liaisons.filter(l => {
    const classe = etat.classes.find(c => c.id === l.classeId);
    if (!classe) return false;
    if (classe.cycle === v.cycle && classe.niveau === v.niveau && normaliser(l.matiere) === normaliser(v.matiere)) return false;
    return true;
  });
  sauvegarder();
  rafraichirTout();
}

/* ==========================================================
   ETAPE 3 : PROFESSEURS + GRILLE DE DISPONIBILITE
   ========================================================== */
let dispoEnCours = {};

function construireGrilleDispo(tableEl, dispoObjet, surClic) {
  let html = "<thead><tr><th>Jour \\ Créneau</th>";
  CRENEAUX_TOUS.forEach(c => html += `<th>${c.id}</th>`);
  html += "</tr></thead><tbody>";
  JOURS.forEach(jour => {
    html += `<tr><td>${jour}</td>`;
    CRENEAUX_TOUS.forEach(c => {
      const actif = dispoObjet[jour] && dispoObjet[jour][c.id];
      html += `<td class="case-dispo ${actif ? 'actif' : ''}" onclick="${surClic}('${jour}','${c.id}')">${actif ? '✓' : ''}</td>`;
    });
    html += "</tr>";
  });
  html += "</tbody>";
  tableEl.innerHTML = html;
}
function toggleDispoNouveau(jour, creneauId) {
  dispoEnCours[jour] = dispoEnCours[jour] || {};
  dispoEnCours[jour][creneauId] = !dispoEnCours[jour][creneauId];
  construireGrilleDispo(document.getElementById("grilleDispoNouveau"), dispoEnCours, "toggleDispoNouveau");
}
function basculerTempsPlein() {
  const total = JOURS.length * CRENEAUX_TOUS.length;
  const nbActifs = Object.values(dispoEnCours).reduce((acc, j) => acc + Object.values(j).filter(Boolean).length, 0);
  const toutCocher = nbActifs < total;
  dispoEnCours = {};
  JOURS.forEach(j => {
    dispoEnCours[j] = {};
    CRENEAUX_TOUS.forEach(c => { dispoEnCours[j][c.id] = toutCocher; });
  });
  construireGrilleDispo(document.getElementById("grilleDispoNouveau"), dispoEnCours, "toggleDispoNouveau");
}
function viderDispoNouveau() {
  dispoEnCours = {};
  construireGrilleDispo(document.getElementById("grilleDispoNouveau"), dispoEnCours, "toggleDispoNouveau");
}
function estTempsPlein(prof) {
  const total = JOURS.length * CRENEAUX_TOUS.length;
  const nbActifs = Object.values(prof.dispo).reduce((acc, j) => acc + Object.values(j).filter(Boolean).length, 0);
  return nbActifs === total;
}

function ajouterProf() {
  const nom = document.getElementById("profNom").value.trim();
  const matieresTxt = document.getElementById("profMatieres").value.trim();
  if (!nom || !matieresTxt) { alert("Indique le nom et au moins une matière."); return; }

  const auMoinsUneDispo = Object.values(dispoEnCours).some(j => Object.values(j).some(v => v));
  if (!auMoinsUneDispo) { alert("Coche au moins une case de disponibilité (ou utilise le bouton temps plein)."); return; }

  etat.profs.push({
    id: nouvelId("prof"),
    nom,
    matieres: matieresTxt.split(",").map(m => m.trim()).filter(Boolean),
    dispo: JSON.parse(JSON.stringify(dispoEnCours))
  });

  document.getElementById("profNom").value = "";
  document.getElementById("profMatieres").value = "";
  dispoEnCours = {};
  construireGrilleDispo(document.getElementById("grilleDispoNouveau"), dispoEnCours, "toggleDispoNouveau");
  sauvegarder();
  rafraichirTout();
}
function supprimerProf(id) {
  if (!confirm("Supprimer ce professeur et les liaisons associées ?")) return;
  etat.profs = etat.profs.filter(p => p.id !== id);
  etat.liaisons = etat.liaisons.filter(l => l.profId !== id);
  sauvegarder();
  rafraichirTout();
}
function afficherListeProfs() {
  const zone = document.getElementById("listeProfs");
  if (etat.profs.length === 0) { zone.innerHTML = "<p style='color:#9c9c96;font-size:13px;'>Aucun professeur ajouté.</p>"; return; }

  let html = "";
  etat.profs.forEach(p => {
    const nbCreneaux = Object.values(p.dispo).reduce((acc, j) => acc + Object.values(j).filter(Boolean).length, 0);
    html += `<div class="carte-prof">
      <div>
        <span class="nom">${p.nom}</span>${estTempsPlein(p) ? '<span class="tag-temps-plein">Temps plein</span>' : ''}
        <div class="details">${p.matieres.join(", ")} — ${nbCreneaux} créneau(x) disponible(s)/semaine</div>
      </div>
      <button class="danger" onclick="supprimerProf('${p.id}')">Supprimer</button>
    </div>`;
  });
  zone.innerHTML = html;
}

/* ==========================================================
   ETAPE 4 : LIAISONS (classe + matière -> professeur)
   ========================================================== */
function rafraichirMatieresLiaison() {
  const classeId = document.getElementById("liaisonClasse").value;
  const classe = etat.classes.find(c => c.id === classeId);
  const select = document.getElementById("liaisonMatiere");
  const matieres = classe ? matieresPourClasse(classe) : [];
  select.innerHTML = matieres.map(v => `<option value="${v.matiere}">${v.matiere} (${v.heures}h)</option>`).join("");
  rafraichirProfsLiaison();
}
function rafraichirProfsLiaison() {
  const matiere = document.getElementById("liaisonMatiere").value;
  const select = document.getElementById("liaisonProf");
  const avert = document.getElementById("avertLiaison");
  const profsPossibles = etat.profs.filter(p => p.matieres.some(m => normaliser(m) === normaliser(matiere)));
  select.innerHTML = profsPossibles.map(p => `<option value="${p.id}">${p.nom}</option>`).join("");
  if (matiere && profsPossibles.length === 0) {
    avert.innerHTML = `<div class="message-avert">Aucun professeur ne déclare enseigner "<b>${matiere}</b>". Vérifie l'orthographe de la matière à l'étape 3 (ex: "PC" vs "Physique-Chimie" doivent être identiques).</div>`;
  } else {
    avert.innerHTML = "";
  }
}
function ajouterLiaison() {
  const classeId = document.getElementById("liaisonClasse").value;
  const matiere = document.getElementById("liaisonMatiere").value;
  const profId = document.getElementById("liaisonProf").value;
  if (!classeId || !matiere || !profId) { alert("Renseigne d'abord les étapes 1 à 3, et vérifie qu'un professeur est disponible pour cette matière."); return; }

  const existeDeja = etat.liaisons.some(l => l.classeId === classeId && normaliser(l.matiere) === normaliser(matiere));
  if (existeDeja) { alert("Cette matière est déjà liée à un professeur pour cette classe."); return; }

  etat.liaisons.push({ id: nouvelId("liaison"), classeId, matiere, profId });
  sauvegarder();
  rafraichirTout();
}
function supprimerLiaison(id) {
  etat.liaisons = etat.liaisons.filter(l => l.id !== id);
  sauvegarder();
  rafraichirTout();
}

/* ==========================================================
   ETAPE 5 : ALGORITHME DE GENERATION (backtracking, JS pur)
   ========================================================== */
function profDisponible(prof, jour, creneauId) {
  return !!(prof.dispo[jour] && prof.dispo[jour][creneauId]);
}

function genererPlanning() {
  const zoneMsg = document.getElementById("messageGeneration");
  zoneMsg.innerHTML = "";

  if (etat.liaisons.length === 0) {
    zoneMsg.innerHTML = `<div class="message-erreur">Ajoute au moins une liaison à l'étape 4 avant de générer.</div>`;
    return;
  }

  let sessions = [];
  let liaisonsIgnorees = [];
  etat.liaisons.forEach(l => {
    const classe = etat.classes.find(c => c.id === l.classeId);
    const prof = etat.profs.find(p => p.id === l.profId);
    if (!classe || !prof) return;
    const heures = heuresPour(classe, l.matiere);
    if (!heures) { liaisonsIgnorees.push(l); return; }
    for (let i = 0; i < heures; i++) {
      sessions.push({ classeId: classe.id, cycle: classe.cycle, matiere: l.matiere, profId: prof.id });
    }
  });

  const usedClasseSlot = new Set();
  const usedProfSlot = new Set();
  const assignation = [];
  let compteurEtapes = 0;
  const LIMITE_ETAPES = 300000;

  function domainePourSession(s) {
    const creneaux = creneauxDuCycle(s.cycle);
    const prof = etat.profs.find(p => p.id === s.profId);
    const options = [];
    for (const jour of JOURS) {
      for (const c of creneaux) {
        const clesClasse = `${s.classeId}|${jour}|${c.id}`;
        const clesProf = `${s.profId}|${jour}|${c.id}`;
        if (usedClasseSlot.has(clesClasse)) continue;
        if (usedProfSlot.has(clesProf)) continue;
        if (!profDisponible(prof, jour, c.id)) continue;
        options.push({ jour, creneauId: c.id });
      }
    }
    return options;
  }

  function backtrack(restantes) {
    compteurEtapes++;
    if (compteurEtapes > LIMITE_ETAPES) return "timeout";
    if (restantes.length === 0) return true;

    let indexChoisi = -1, meilleurDomaine = null;
    for (let i = 0; i < restantes.length; i++) {
      const d = domainePourSession(restantes[i]);
      if (meilleurDomaine === null || d.length < meilleurDomaine.length) {
        meilleurDomaine = d; indexChoisi = i;
        if (d.length === 0) break;
      }
    }
    if (meilleurDomaine.length === 0) return { blocage: restantes[indexChoisi] };

    const session = restantes[indexChoisi];
    const reste = restantes.slice(0, indexChoisi).concat(restantes.slice(indexChoisi + 1));

    for (const slot of meilleurDomaine) {
      const clesClasse = `${session.classeId}|${slot.jour}|${slot.creneauId}`;
      const clesProf = `${session.profId}|${slot.jour}|${slot.creneauId}`;
      usedClasseSlot.add(clesClasse);
      usedProfSlot.add(clesProf);
      assignation.push({ ...session, jour: slot.jour, creneauId: slot.creneauId });

      const resultat = backtrack(reste);
      if (resultat === true) return true;
      if (resultat === "timeout") return "timeout";

      assignation.pop();
      usedClasseSlot.delete(clesClasse);
      usedProfSlot.delete(clesProf);
    }
    return { blocage: session };
  }

  const resultat = backtrack(sessions);

  let messageIgnorees = "";
  if (liaisonsIgnorees.length > 0) {
    messageIgnorees = `<div class="message-avert">${liaisonsIgnorees.length} liaison(s) ignorée(s) car aucun volume horaire ne correspond (vérifie l'étape 2).</div>`;
  }

  if (resultat === true) {
    etat.resultat = assignation;
    sauvegarder();
    zoneMsg.innerHTML = `<div class="message-succes">Emploi du temps généré avec succès (0 conflit).</div>${messageIgnorees}`;
    document.getElementById("zoneResultat").style.display = "block";
    afficherResultat();
  } else if (resultat === "timeout") {
    zoneMsg.innerHTML = `<div class="message-erreur">Le calcul a pris trop de temps. Réduis le nombre d'heures demandées ou élargis les disponibilités des professeurs.</div>${messageIgnorees}`;
  } else {
    const classe = etat.classes.find(c => c.id === resultat.blocage.classeId);
    const prof = etat.profs.find(p => p.id === resultat.blocage.profId);
    zoneMsg.innerHTML = `<div class="message-erreur">
      Impossible de placer un cours de <b>${resultat.blocage.matiere}</b>
      pour la classe <b>${classe ? nomClasse(classe) : "?"}</b>
      avec le professeur <b>${prof ? prof.nom : "?"}</b>.<br>
      Cause probable : pas assez de disponibilités déclarées pour ce professeur,
      ou trop d'heures demandées par rapport aux créneaux disponibles.
    </div>${messageIgnorees}`;
  }
}

/* ==========================================================
   AFFICHAGE DU RESULTAT
   ========================================================== */
let classeAffichee = null;

function afficherResultat() {
  const onglets = document.getElementById("ongletsClasses");
  onglets.innerHTML = "";
  etat.classes.forEach(c => {
    const btn = document.createElement("div");
    btn.className = "onglet-classe" + (classeAffichee === c.id ? " actif" : "");
    btn.textContent = nomClasse(c);
    btn.onclick = () => { classeAffichee = c.id; afficherResultat(); };
    onglets.appendChild(btn);
  });

  if (!classeAffichee && etat.classes.length > 0) classeAffichee = etat.classes[0].id;
  const classe = etat.classes.find(c => c.id === classeAffichee);
  if (!classe) return;

  const creneaux = creneauxDuCycle(classe.cycle);
  const sessionsClasse = (etat.resultat || []).filter(s => s.classeId === classe.id);

  let html = `<h3 style="font-size:14px; color:var(--marine);">${nomClasse(classe)}</h3><table><thead><tr><th>Créneau</th>`;
  JOURS.forEach(j => html += `<th>${j}</th>`);
  html += "</tr></thead><tbody>";
  creneaux.forEach(c => {
    html += `<tr><td>${c.id}</td>`;
    JOURS.forEach(j => {
      const s = sessionsClasse.find(x => x.jour === j && x.creneauId === c.id);
      if (s) {
        const prof = etat.profs.find(p => p.id === s.profId);
        html += `<td><strong>${s.matiere}</strong><br><span style="font-size:11px;color:#9c9c96;">${prof ? prof.nom : ""}</span></td>`;
      } else {
        html += `<td style="color:#e5e5e0;">—</td>`;
      }
    });
    html += "</tr>";
  });
  html += "</tbody></table>";
  document.getElementById("grilleResultat").innerHTML = html;

  let htmlImpression = `<h1>Emploi du temps — Groupe Scolaire SALDIA</h1>`;
  etat.classes.forEach(cl => {
    const cr = creneauxDuCycle(cl.cycle);
    const sess = (etat.resultat || []).filter(s => s.classeId === cl.id);
    htmlImpression += `<h2>${nomClasse(cl)}</h2><table><tr><th>Créneau</th>`;
    JOURS.forEach(j => htmlImpression += `<th>${j}</th>`);
    htmlImpression += "</tr>";
    cr.forEach(c => {
      htmlImpression += `<tr><td>${c.id}</td>`;
      JOURS.forEach(j => {
        const s = sess.find(x => x.jour === j && x.creneauId === c.id);
        const prof = s ? etat.profs.find(p => p.id === s.profId) : null;
        htmlImpression += `<td>${s ? s.matiere + (prof ? " (" + prof.nom + ")" : "") : ""}</td>`;
      });
      htmlImpression += "</tr>";
    });
    htmlImpression += "</table>";
  });
  document.getElementById("resultatImpression").innerHTML = htmlImpression;
}

/* ==========================================================
   RAFRAICHISSEMENT GENERAL DE L'INTERFACE
   ========================================================== */
function rafraichirTout() {
  // Table des classes
  const tbodyClasses = document.querySelector("#tableClasses tbody");
  tbodyClasses.innerHTML = etat.classes.map(c => `
    <tr><td>${c.niveau} ${c.division}</td><td>${c.cycle}</td>
    <td><button class="danger" onclick="supprimerClasse('${c.id}')">Supprimer</button></td></tr>
  `).join("");

  // Select des niveaux (étape 2) — déduits des classes
  const niveaux = niveauxDistincts();
  document.getElementById("volumeNiveau").innerHTML = niveaux.map(n => `<option value="${n.cle}">${nomNiveau(n)}</option>`).join("");

  // Select des classes (étape 4)
  const optionsClasses = etat.classes.map(c => `<option value="${c.id}">${nomClasse(c)}</option>`).join("");
  document.getElementById("liaisonClasse").innerHTML = optionsClasses;

  // Table des volumes horaires
  const tbodyVolumes = document.querySelector("#tableVolumes tbody");
  tbodyVolumes.innerHTML = etat.volumesParNiveau.map(v => `
    <tr><td>${v.niveau} (${v.cycle})</td><td>${v.matiere}</td><td>${v.heures}h</td>
    <td>${nbClassesDuNiveau(v.cycle, v.niveau)} classe(s)</td>
    <td><button class="danger" onclick="supprimerVolume('${v.id}')">Supprimer</button></td></tr>
  `).join("");

  afficherListeProfs();
  rafraichirMatieresLiaison();

  const tbodyLiaisons = document.querySelector("#tableLiaisons tbody");
  tbodyLiaisons.innerHTML = etat.liaisons.map(l => {
    const classe = etat.classes.find(c => c.id === l.classeId);
    const prof = etat.profs.find(p => p.id === l.profId);
    const heures = classe ? heuresPour(classe, l.matiere) : null;
    return `<tr><td>${classe ? nomClasse(classe) : "?"}</td><td>${l.matiere}</td><td>${prof ? prof.nom : "?"}</td><td>${heures ? heures + "h" : "—"}</td>
      <td><button class="danger" onclick="supprimerLiaison('${l.id}')">Supprimer</button></td></tr>`;
  }).join("");

  construireNavEtapes();

  if (etat.resultat && etat.resultat.length > 0) {
    document.getElementById("zoneResultat").style.display = "block";
    afficherResultat();
  }
}

