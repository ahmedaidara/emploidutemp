/* ==========================================================
   ATTRIBUTION AUTOMATIQUE DES PROFESSEURS (remplace l'étape manuelle)
   ========================================================== */
function autoAssignerProfs() {
  const liaisons = [];
  const erreurs = [];

  etat.volumesParNiveau.forEach(v => {
    const classesDuNiveau = etat.classes.filter(c => c.cycle === v.cycle && c.niveau === v.niveau);
    if (classesDuNiveau.length === 0) return;

    const cleNiveau = v.cycle + "||" + v.niveau;
    const eligibles = etat.profs.filter(p =>
      p.matieres.some(m => normaliser(m) === normaliser(v.matiere)) &&
      p.niveaux.includes(cleNiveau)
    );

    if (eligibles.length === 0) {
      erreurs.push({ cycle: v.cycle, niveau: v.niveau, matiere: v.matiere });
      return;
    }

    const charge = {};
    eligibles.forEach(p => charge[p.id] = 0);
    const assignees = new Set();

    // 1) Respecter les préférences en premier
    classesDuNiveau.forEach(classe => {
      const preferents = eligibles.filter(p => (p.preferences || []).includes(classe.id));
      if (preferents.length > 0) {
        preferents.sort((a, b) => charge[a.id] - charge[b.id]);
        const choisi = preferents[0];
        liaisons.push({ classeId: classe.id, matiere: v.matiere, profId: choisi.id });
        charge[choisi.id]++;
        assignees.add(classe.id);
      }
    });

    // 2) Répartir le reste en équilibrant la charge entre profs éligibles
    classesDuNiveau.filter(c => !assignees.has(c.id)).forEach(classe => {
      eligibles.sort((a, b) => charge[a.id] - charge[b.id]);
      const choisi = eligibles[0];
      liaisons.push({ classeId: classe.id, matiere: v.matiere, profId: choisi.id });
      charge[choisi.id]++;
    });
  });

  return { liaisons, erreurs };
}

/* ==========================================================
   GENERATION DU PLANNING (backtracking, JS pur)
   ========================================================== */
function profDisponible(prof, jour, creneauId) { return !!(prof.dispo[jour] && prof.dispo[jour][creneauId]); }

function genererPlanning() {
  const zoneMsg = document.getElementById("messageGeneration");
  zoneMsg.innerHTML = "";
  document.getElementById("zoneAttribution").style.display = "none";
  document.getElementById("zoneResultat").style.display = "none";

  if (etat.volumesParNiveau.length === 0 || etat.classes.length === 0) {
    zoneMsg.innerHTML = `<div class="message-erreur">Complète d'abord les étapes 1 et 2.</div>`;
    return;
  }

  const { liaisons, erreurs } = autoAssignerProfs();

  let messageManques = "";
  if (erreurs.length > 0) {
    const liste = erreurs.map(e => `${e.niveau} (${e.cycle}) → ${e.matiere}`).join(" · ");
    messageManques = `<div class="message-avert">
      ${erreurs.length} matière(s) sans professeur, laissée(s) vide(s) dans le planning :<br><b>${liste}</b><br>
      Complète-les à l'étape 3, puis reviens ici pour re-générer. Détail par classe : étape 4 (Suivi).
    </div>`;
  }
  if (liaisons.length === 0) {
    zoneMsg.innerHTML = `<div class="message-erreur">Aucune attribution possible pour l'instant. Vérifie les étapes 1 à 3.</div>${messageManques}`;
    return;
  }

  etat.resultatAttribution = liaisons;
  afficherAttribution(liaisons);

  let sessions = [];
  liaisons.forEach(l => {
    const classe = etat.classes.find(c => c.id === l.classeId);
    const heures = heuresPour(classe, l.matiere);
    if (!heures) return;
    for (let i = 0; i < heures; i++) sessions.push({ classeId: classe.id, cycle: classe.cycle, matiere: l.matiere, profId: l.profId });
  });

  const usedClasseSlot = new Set();
  const usedProfSlot = new Set();
  const assignation = [];
  let compteurEtapes = 0;
  const LIMITE_ETAPES = 300000;

  function domainePourSession(s) {
    const creneaux = creneauxDuCycle(s.cycle);
    const prof = etat.profs.find(p => p.id === s.profId);
    const options = [];
    for (const jour of JOURS) {
      for (const c of creneaux) {
        const clesClasse = `${s.classeId}|${jour}|${c.id}`;
        const clesProf = `${s.profId}|${jour}|${c.id}`;
        if (usedClasseSlot.has(clesClasse)) continue;
        if (usedProfSlot.has(clesProf)) continue;
        if (!profDisponible(prof, jour, c.id)) continue;
        options.push({ jour, creneauId: c.id });
      }
    }
    return options;
  }

  function backtrack(restantes) {
    compteurEtapes++;
    if (compteurEtapes > LIMITE_ETAPES) return "timeout";
    if (restantes.length === 0) return true;

    let indexChoisi = -1, meilleurDomaine = null;
    for (let i = 0; i < restantes.length; i++) {
      const d = domainePourSession(restantes[i]);
      if (meilleurDomaine === null || d.length < meilleurDomaine.length) { meilleurDomaine = d; indexChoisi = i; if (d.length === 0) break; }
    }
    if (meilleurDomaine.length === 0) return { blocage: restantes[indexChoisi] };

    const session = restantes[indexChoisi];
    const reste = restantes.slice(0, indexChoisi).concat(restantes.slice(indexChoisi + 1));

    for (const slot of meilleurDomaine) {
      const clesClasse = `${session.classeId}|${slot.jour}|${slot.creneauId}`;
      const clesProf = `${session.profId}|${slot.jour}|${slot.creneauId}`;
      usedClasseSlot.add(clesClasse); usedProfSlot.add(clesProf);
      assignation.push({ ...session, jour: slot.jour, creneauId: slot.creneauId });

      const resultat = backtrack(reste);
      if (resultat === true) return true;
      if (resultat === "timeout") return "timeout";

      assignation.pop();
      usedClasseSlot.delete(clesClasse); usedProfSlot.delete(clesProf);
    }
    return { blocage: session };
  }

  const resultat = backtrack(sessions);

  if (resultat === true) {
    etat.resultat = assignation;
    sauvegarder();
    zoneMsg.innerHTML = `<div class="message-succes">Emploi du temps généré avec succès (0 conflit).</div>${messageManques}`;
    document.getElementById("zoneResultat").style.display = "block";
    afficherResultat();
  } else if (resultat === "timeout") {
    zoneMsg.innerHTML = `<div class="message-erreur">Le calcul a pris trop de temps. Réduis les heures demandées ou élargis les disponibilités.</div>${messageManques}`;
  } else {
    const classe = etat.classes.find(c => c.id === resultat.blocage.classeId);
    const prof = etat.profs.find(p => p.id === resultat.blocage.profId);
    zoneMsg.innerHTML = `<div class="message-erreur">
      Impossible de placer un cours de <b>${resultat.blocage.matiere}</b> pour <b>${classe ? nomClasse(classe) : "?"}</b>
      avec <b>${prof ? prof.nom : "?"}</b>.<br>Cause probable : disponibilités insuffisantes pour ce professeur au vu du nombre de classes qui lui sont attribuées.
    </div>${messageManques}`;
  }
}

function afficherAttribution(liaisons) {
  const zone = document.getElementById("zoneAttribution");
  const contenu = document.getElementById("tableAttribution");
  let html = `<table><thead><tr><th>Classe</th><th>Matière</th><th>Professeur</th><th>Heures</th></tr></thead><tbody>`;
  liaisons.forEach(l => {
    const classe = etat.classes.find(c => c.id === l.classeId);
    const prof = etat.profs.find(p => p.id === l.profId);
    const heures = classe ? heuresPour(classe, l.matiere) : null;
    html += `<tr><td>${classe ? nomClasse(classe) : "?"}</td><td>${l.matiere}</td><td>${prof ? prof.nom : "?"}</td><td>${heures ? heures + "h" : "—"}</td></tr>`;
  });
  html += `</tbody></table>`;
  contenu.innerHTML = html;
  zone.style.display = "block";
}

/* ==========================================================
   ETAPE 4 : SUIVI (ce qui manque, par classe et par professeur)
   ========================================================== */
function afficherSuivi() {
  const { liaisons, erreurs } = autoAssignerProfs();

  // --- Résumé en tête de page ---
  const zoneResume = document.getElementById("resumeSuivi");
  if (etat.classes.length === 0 || etat.volumesParNiveau.length === 0) {
    zoneResume.innerHTML = `<div class="message-avert">Complète d'abord les étapes 1 et 2 pour voir le suivi.</div>`;
  } else if (erreurs.length === 0) {
    zoneResume.innerHTML = `<div class="message-succes">Tout est couvert : chaque matière de chaque niveau a un professeur.</div>`;
  } else {
    zoneResume.innerHTML = `<div class="message-avert">${erreurs.length} matière(s) sans professeur pour l'instant — le planning pourra quand même être généré, ces cases resteront vides.</div>`;
  }

  // --- Par classe ---
  const zoneClasse = document.getElementById("suiviParClasse");
  if (etat.classes.length === 0) {
    zoneClasse.innerHTML = "<p style='color:#9c9c96;font-size:13px;'>Aucune classe.</p>";
  } else {
    let html = `<table><thead><tr><th>Classe</th><th>Matière</th><th>Heures</th><th>Professeur</th></tr></thead><tbody>`;
    etat.classes.forEach(classe => {
      const matieres = matieresPourClasse(classe);
      if (matieres.length === 0) {
        html += `<tr><td>${nomClasse(classe)}</td><td colspan="3" style="color:#b8860b;">Aucune matière réglée pour ce niveau (étape 2)</td></tr>`;
        return;
      }
      matieres.forEach(v => {
        const liaison = liaisons.find(l => l.classeId === classe.id && normaliser(l.matiere) === normaliser(v.matiere));
        const prof = liaison ? etat.profs.find(p => p.id === liaison.profId) : null;
        html += `<tr><td>${nomClasse(classe)}</td><td>${v.matiere}</td><td>${v.heures}h</td>
          <td>${prof ? prof.nom : '<span style="color:#b91c1c;font-weight:600;">⚠ Aucun professeur</span>'}</td></tr>`;
      });
    });
    html += `</tbody></table>`;
    zoneClasse.innerHTML = html;
  }

  // --- Par professeur ---
  const zoneProf = document.getElementById("suiviParProf");
  if (etat.profs.length === 0) {
    zoneProf.innerHTML = "<p style='color:#9c9c96;font-size:13px;'>Aucun professeur.</p>";
  } else {
    let html = `<table><thead><tr><th>Professeur</th><th>Matière(s)</th><th>Niveaux couverts</th><th>Classes attribuées</th></tr></thead><tbody>`;
    etat.profs.forEach(p => {
      const assignations = liaisons.filter(l => l.profId === p.id);
      const niveauxTxt = p.niveaux.map(cle => { const [cycle, niveau] = cle.split("||"); return `${niveau} (${cycle})`; }).join(", ");
      const classesTxt = assignations.map(l => { const c = etat.classes.find(x => x.id === l.classeId); return c ? `${nomClasse(c)} (${l.matiere})` : null; }).filter(Boolean).join(", ");
      html += `<tr><td>${p.nom}</td><td>${p.matieres.join(", ")}</td><td>${niveauxTxt || "—"}</td>
        <td>${classesTxt || '<span style="color:#b8860b;">Aucune classe attribuée pour l’instant</span>'}</td></tr>`;
    });
    html += `</tbody></table>`;
    zoneProf.innerHTML = html;
  }
}

/* ==========================================================
   AFFICHAGE DU RESULTAT
   ========================================================== */
let classeAffichee = null;

function afficherResultat() {
  if (etat.resultatAttribution) afficherAttribution(etat.resultatAttribution);

  const onglets = document.getElementById("ongletsClasses");
  onglets.innerHTML = "";
  etat.classes.forEach(c => {
    const btn = document.createElement("div");
    btn.className = "onglet-classe" + (classeAffichee === c.id ? " actif" : "");
    btn.textContent = nomClasse(c);
    btn.onclick = () => { classeAffichee = c.id; afficherResultat(); };
    onglets.appendChild(btn);
  });

  if (!classeAffichee && etat.classes.length > 0) classeAffichee = etat.classes[0].id;
  const classe = etat.classes.find(c => c.id === classeAffichee);
  if (!classe) return;

  const creneaux = creneauxDuCycle(classe.cycle);
  const sessionsClasse = (etat.resultat || []).filter(s => s.classeId === classe.id);

  let html = `<h3 style="font-size:14px; color:var(--marine);">${nomClasse(classe)}</h3><table><thead><tr><th>Horaire</th>`;
  JOURS.forEach(j => html += `<th>${j}</th>`);
  html += "</tr></thead><tbody>";
  creneaux.forEach(c => {
    html += `<tr><td>${c.label}</td>`;
    JOURS.forEach(j => {
      const s = sessionsClasse.find(x => x.jour === j && x.creneauId === c.id);
      if (s) {
        const prof = etat.profs.find(p => p.id === s.profId);
        html += `<td><strong>${s.matiere}</strong><br><span style="font-size:11px;color:#9c9c96;">${prof ? prof.nom : ""}</span></td>`;
      } else { html += `<td style="color:#e5e5e0;">—</td>`; }
    });
    html += "</tr>";
  });
  html += "</tbody></table>";
  document.getElementById("grilleResultat").innerHTML = html;

  let htmlImpression = `<h1>Emploi du temps — Groupe Scolaire SALDIA</h1>`;
  etat.classes.forEach(cl => {
    const cr = creneauxDuCycle(cl.cycle);
    const sess = (etat.resultat || []).filter(s => s.classeId === cl.id);
    htmlImpression += `<h2>${nomClasse(cl)}</h2><table><tr><th>Horaire</th>`;
    JOURS.forEach(j => htmlImpression += `<th>${j}</th>`);
    htmlImpression += "</tr>";
    cr.forEach(c => {
      htmlImpression += `<tr><td>${c.label}</td>`;
      JOURS.forEach(j => {
        const s = sess.find(x => x.jour === j && x.creneauId === c.id);
        const prof = s ? etat.profs.find(p => p.id === s.profId) : null;
        htmlImpression += `<td>${s ? s.matiere + (prof ? " (" + prof.nom + ")" : "") : ""}</td>`;
      });
      htmlImpression += "</tr>";
    });
    htmlImpression += "</table>";
  });
  document.getElementById("resultatImpression").innerHTML = htmlImpression;
}

/* ==========================================================
   RAFRAICHISSEMENT GENERAL
   ========================================================== */
function rafraichirTout() {
  rendreClassesGroupees();

  const niveaux = niveauxDistincts();
  document.getElementById("volumeNiveau").innerHTML = niveaux.map(n => `<option value="${n.cle}">${nomNiveau(n)}</option>`).join("");
  rendreVolumesGroupees();

  if (!profEnEdition) {
    construireCasesMatieresProf([]);
    construireCasesNiveauxProf([]);
    rafraichirCasesPreferencesProf([]);
  }
  afficherListeProfs();
  afficherSuivi();

  construireNavEtapes();

  if (etat.resultat && etat.resultat.length > 0) {
    document.getElementById("zoneResultat").style.display = "block";
    afficherResultat();
  }
}

/* ==========================================================
   DEMARRAGE
   ========================================================== */
(async function demarrer() {
  try {
    await charger();
  } catch (e) {
    console.error("Chargement (cloud ou local) en échec, poursuite quand même:", e);
  }
  try {
    construireGrilleDispo(document.getElementById("grilleDispoNouveau"), dispoEnCours, "toggleDispoNouveau");
  } catch (e) {
    console.error("Erreur à la construction de la grille de disponibilité:", e);
  }
  try {
    rafraichirTout();
  } catch (e) {
    console.error("Erreur à l'affichage général:", e);
  }
  try {
    allerEtape(1);
  } catch (e) {
    console.error("Erreur de navigation initiale:", e);
  }
})();
